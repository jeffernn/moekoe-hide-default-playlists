{
  "manifest_version": 3,
  "plugin_id": "moekoe-hide-default-playlists",
  "name": "MoeKoe 隐藏默认歌单",
  "version": "1.0.2",
  "description": "安全、高效地隐藏音乐库与侧边栏中的默认歌单及入口（我的云盘、本地音乐、创建歌单、我喜欢、默认收藏等），支持天空蓝可视化配置。",
  "author": "Jeffern",
  "minversion": null,
  "moekoe": true,
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "https://*.music.moekoe.cn/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hook.js"],
      "matches": [
        "http://localhost:*/*",
        "https://*.music.moekoe.cn/*",
        "file:///*"
      ]
    }
  ]
}
